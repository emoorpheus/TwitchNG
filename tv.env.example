# tv.env - local settings for the TV tools (deploy/install.sh, deploy/rollback.sh, probe/sttv-cdp.mjs, CODEX_TV_TEST.md).
# Copy to tv.env and put your TV's address there; tv.env is git-ignored, so the address never ends up in the repo:
#   cp tv.env.example tv.env && $EDITOR tv.env && . ./tv.env
# 192.0.2.10 is a documentation address (RFC 5737), not a real TV.
export TV_HOST=192.0.2.10
